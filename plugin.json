{
  "id": "gallery-dl",
  "name": "gallerydl",
  "version": "1.5.1",
  "description": "Background gallery-dl and yt-dlp task management, quick downloads, kiosks, OAuth configuration, and a persistent activity log.",
  "author": "LainStable",
  "repository": "https://github.com/LainStable/SDCodex-GalleryDL",
  "icon": "\u2913",
  "entry_page": "tasks",
  "nav_items": [
    {
      "label": "Tasks",
      "icon": "\u2630",
      "page": "tasks"
    },
    {
      "label": "Quick Download",
      "icon": "\u2913",
      "page": "one-time"
    },
    {
      "label": "Kiosks",
      "icon": "\u25a3",
      "page": "kiosks"
    },
    {
      "label": "OAuth",
      "icon": "\u26bf",
      "page": "oauth"
    },
    {
      "label": "Logs",
      "icon": "\u2261",
      "page": "logs"
    }
  ],
  "settings": [
    {
      "label": "GalleryDL",
      "page": "settings"
    }
  ],
  "volumes": [
    {
      "env_var": "TASKS",
      "host_path": "./tasks",
      "container_path": "/data/tasks",
      "description": "Directory for background task definitions, outputs and logs"
    },
    {
      "env_var": "CONFIG",
      "host_path": "./config",
      "container_path": "/data/config",
      "description": "Directory for gallery-dl.conf, kiosk configurations, and secrets"
    },
    {
      "env_var": "IMAGES",
      "host_path": "./downloads",
      "container_path": "/data/downloads",
      "description": "Output directory for quick downloads and tools"
    }
  ],
  "entrypoint": "plugin:init_plugin",
  "task_status": {
    "label": "GalleryDL",
    "path": "/gdl/api/task",
    "page": "tasks"
  },
  "assistant_actions": [
    {
      "name": "queue_status",
      "description": "List gallery-dl tasks and the download queue.",
      "method": "GET",
      "path": "/gdl/api/queue"
    },
    {
      "name": "task_history",
      "description": "Recent downloads and history for a gallery-dl task.",
      "method": "GET",
      "path": "/gdl/api/tasks/{slug}/history",
      "params": [
        {
          "name": "slug",
          "required": true,
          "description": "Task slug (see queue_status)."
        }
      ]
    },
    {
      "name": "start_task",
      "description": "Start a gallery-dl task by slug.",
      "method": "POST",
      "path": "/gdl/api/tasks/{slug}/start",
      "confirm": true,
      "params": [
        {
          "name": "slug",
          "required": true,
          "description": "Task slug (see queue_status)."
        }
      ]
    },
    {
      "name": "stop_task",
      "description": "Stop a running gallery-dl task by slug.",
      "method": "POST",
      "path": "/gdl/api/tasks/{slug}/stop",
      "confirm": true,
      "params": [
        {
          "name": "slug",
          "required": true,
          "description": "Task slug."
        }
      ]
    }
  ]
}
